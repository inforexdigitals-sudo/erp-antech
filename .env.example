# Copy to .env and fill in real values. Never commit .env.
# See docs/phase-3-system-architecture/deployment.md for how these are
# supplied per-environment (local / staging / production).

# --- Database ---------------------------------------------------------
POSTGRES_USER=antech
POSTGRES_PASSWORD=change_me
POSTGRES_DB=antech_erp
DATABASE_URL=postgresql://antech:change_me@localhost:5432/antech_erp

# --- Redis --------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible; MinIO locally, real S3 in the cloud) --
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=antech-documents
S3_ACCESS_KEY_ID=antech
S3_SECRET_ACCESS_KEY=change_me
MINIO_ROOT_USER=antech
MINIO_ROOT_PASSWORD=change_me

# --- Auth ---------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_generate_a_long_random_value
JWT_REFRESH_SECRET=change_me_generate_a_different_long_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
TWO_FACTOR_ENCRYPTION_KEY=change_me_32_byte_key

# --- Email ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# --- Accounting integrations (module 13) ---------------------------------
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# --- App ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Deployment (used by infra/docker-compose.prod.yml / CI) -------------
REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest
